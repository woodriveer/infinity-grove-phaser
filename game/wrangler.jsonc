{
    // Free fixed address https://infinity-grove.<your-subdomain>.workers.dev: static game + /api proxy to the backend
    "name": "infinity-grove",
    "main": "worker/index.js",
    "compatibility_date": "2025-09-01",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    }
}
